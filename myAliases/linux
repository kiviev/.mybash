##### Tailwind

alias ts='sudo tailscale'
alias tsup='ts up'
alias tsdown='sudo tailscale down'
alias tslist='ts exit-node list'
alias tsvps='tsup --exit-node=vps --accept-routes && tslist'
alias tshome='tsup --exit-node=home --accept-routes && tslist'
alias tsstatus='sudo tailscale status'

